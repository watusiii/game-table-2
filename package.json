{
  "name": "game-table-2",
  "private": true,
  "version": "0.0.1",
  "description": "A shared studio for making things together: live editing, chat, a GitHub-backed repo, and room for AI helpers.",
  "license": "MIT",
  "author": "watusiii",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watusiii/game-table-2.git"
  },
  "bugs": {
    "url": "https://github.com/watusiii/game-table-2/issues"
  },
  "homepage": "https://github.com/watusiii/game-table-2#readme",
  "keywords": [
    "collaboration",
    "realtime",
    "yjs",
    "codemirror",
    "game-development",
    "ai-agents",
    "websocket"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "share": "vite build && node scripts/dev.mjs --preview",
    "server": "node server/server.mjs",
    "table": "node cli/table.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.0",
    "@lezer/highlight": "^1.2.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "ws": "^8.18.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^8.3.2"
  }
}
